+            rightItems: rightDisp,
+            rightSelection: rightSelection,
+            rightCursorId: rightCursorItemId
+        )
+        self.fileCompareState = state
+        
+        guard case .ready(let leftTarget, let rightTarget) = state else {
+            self.activeFileDiffResult = nil
