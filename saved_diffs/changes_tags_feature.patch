+            self.diffLeftStatusMessage = err.message
+            self.diffLeftPreviewLines = []
+        }
+        
+        switch rightRes {
+        case .success(let target):
+            self.activeDiffRightTarget = target
+            self.diffRightStatusMessage = ""
