+        .background(
+            RoundedRectangle(cornerRadius: 5)
+                .fill(Color(nsColor: .controlColor).opacity(0.22))
+        )
+        .overlay(
+            RoundedRectangle(cornerRadius: 5)
+                .strokeBorder(Color.primary.opacity(0.06), lineWidth: 1)
+        )
+        .help(helpText)
+    }
+}
